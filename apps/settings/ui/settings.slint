import { Button, ComboBox, GroupBox, LineEdit, ScrollView, TextEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component SettingsWindow inherits Window {
    title: "Verba · 拾言输入法 — 设置";
    width: 800px;
    height: 680px;

    // ---------- 状态 ----------
    in-out property <string> status-text: "正在连接 daemon…";
    in-out property <string> version-text: "";

    // ---------- LLM（远程） ----------
    in-out property <string> llm-base-url;
    in-out property <string> llm-model;
    // 由 Rust 侧填充：打开面板时先播种当前配置的模型，再（有 API Key 时）自动拉取服务商真实列表。
    // 这里不留写死的占位模型——占位值会被误读成"真实可用列表"（2026-09-21 用户反馈）。
    in-out property <[string]> llm-models;
    in-out property <int> llm-model-index: -1;
    in-out property <string> temperature;
    in-out property <string> max-tokens;
    in-out property <string> ai-system-prompt;
    in-out property <string> ai-context-turns;
    in-out property <string> api-key-state: "未设置";
    in-out property <string> api-key-input: "";

    // ---------- 实验性能力（ASR/TTS，UI 入口隐藏） ----------
    in-out property <int> asr-provider-index: 0;
    in-out property <string> asr-base-url;
    in-out property <string> asr-model;
    in-out property <int> tts-provider-index: 0;
    in-out property <string> tts-base-url;
    in-out property <string> tts-model;
    in-out property <string> tts-voice;

    // ---------- 候选 ----------
    in-out property <string> rime-schema;
    in-out property <int> theme-index: 0;

    // ---------- 快捷短语 ----------
    in-out property <string> phrase-name;
    in-out property <string> phrase-text;
    in-out property <string> phrase-status;

    // ---------- 回调 ----------
    callback save();
    callback save-phrase();
    callback delete-phrase();
    callback refresh-phrases();
    callback refresh();
    callback refresh-models();
    callback set-api-key(string);
    callback clear-api-key();
    callback install-rare-chars();


    VerticalBox {
        padding: 12px;
        spacing: 10px;

        HorizontalBox {
            alignment: space-between;
            HorizontalBox {
                spacing: 8px;
                Text { text: "Verba · 拾言输入法"; font-size: 18px; font-weight: 700; }
                Text { text: version-text; color: #888888; vertical-alignment: center; }
            }
            Button { text: "重新加载"; clicked => { root.refresh(); } }
        }

        ScrollView {
            VerticalBox {
                spacing: 12px;
                padding: 2px;

                GroupBox {
                    title: "LLM（远程，统一 OpenAI 兼容接口）";
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox { spacing: 8px; Text { text: "模型"; width: 130px; vertical-alignment: center; } ComboBox { model: root.llm-models; current-index <=> root.llm-model-index; } Button { text: "刷新模型"; clicked => { root.refresh-models(); } } }
                        HorizontalBox { spacing: 8px; Text { text: "温度"; width: 130px; vertical-alignment: center; } LineEdit { text <=> root.temperature; placeholder-text: "0.7"; } }
                        HorizontalBox { spacing: 8px; Text { text: "最大 Tokens"; width: 130px; vertical-alignment: center; } LineEdit { text <=> root.max-tokens; placeholder-text: "1024"; } }
                        HorizontalBox { spacing: 8px; Text { text: "多轮上下文"; width: 130px; vertical-alignment: center; } LineEdit { text <=> root.ai-context-turns; placeholder-text: "0=关闭；>0 记忆最近 N 轮（含上屏文本，//new 清空）"; } }
                        Text { text: "AI 系统提示词"; }
                        TextEdit { text <=> root.ai-system-prompt; height: 64px; placeholder-text: "留空使用默认：输入法 AI 助手，回答简洁、可上屏，不用 Markdown"; }
                        Text { text: "API Key"; }
                        LineEdit { text <=> root.api-key-input; input-type: InputType.password; placeholder-text: "输入新密钥后点「保存密钥」（留空不修改）"; }
                        HorizontalBox {
                            alignment: space-between;
                            Text { text: api-key-state; vertical-alignment: center; color: #666666; }
                            HorizontalBox {
                                spacing: 8px;
                                Button { text: "保存密钥"; clicked => { root.set-api-key(root.api-key-input); } }
                                Button { text: "清除密钥"; clicked => { root.clear-api-key(); } }
                            }
                        }
                    }
                }

                GroupBox {
                    title: "候选窗";
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox { spacing: 8px; Text { text: "Rime 方案"; width: 130px; vertical-alignment: center; } LineEdit { text <=> root.rime-schema; placeholder-text: "luna_pinyin_simp / wubi86"; } }
                        HorizontalBox { spacing: 8px; Text { text: "候选窗主题"; width: 130px; vertical-alignment: center; } ComboBox { model: ["light（浅色）", "dark（深色）"]; current-index <=> root.theme-index; } }
                    }
                }

                GroupBox {
                    title: "生僻字扩展";
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: "把 Verba 补充词条（如 biáng 等生僻字）安装到 Rime 用户词库并重新部署，安装后可输入 biang 拼音直接上屏。"; wrap: word-wrap; }
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: "安装生僻字扩展"; clicked => { root.install-rare-chars(); } }
                        }
                    }
                }

                GroupBox {
                    title: "快捷键（当前内置，后续可配置）";
                    VerticalBox {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "Ctrl+Alt+O：选区截图 → OCR 上屏"; }
                        Text { text: "Ctrl+Alt+S：打开设置面板"; }
                        Text { text: "//截图   // 前缀进入 AI 模式（LLM 流式，Enter 上屏）"; }
                    }
                }

                GroupBox {
                    title: "快捷短语（`//短语 <名称>` 一键插入）";
                    VerticalBox {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalBox { spacing: 8px; Text { text: "名称"; width: 90px; vertical-alignment: center; } LineEdit { text <=> root.phrase-name; placeholder-text: "如 greet"; } }
                        Text { text: "内容"; }
                        TextEdit { text <=> root.phrase-text; height: 64px; placeholder-text: "输入要插入的文本，如“你好，我是 Verba”"; }
                        HorizontalBox {
                            spacing: 8px;
                            Button { text: "保存短语"; clicked => { root.save-phrase(); } }
                            Button { text: "删除当前"; clicked => { root.delete-phrase(); } }
                            Button { text: "刷新"; clicked => { root.refresh-phrases(); } }
                        }
                        Text { text: phrase-status; color: #666666; wrap: word-wrap; }
                    }
                }

                GroupBox {
                    title: "隐私与说明";
                    VerticalBox {
                        padding: 8px;
                        spacing: 4px;
                        Text { text: "LLM 与 `//看图` 会把文本/图片发送到你配置的远程服务商。"; wrap: word-wrap; }
                        Text { text: "API Key 存入系统密钥库（keyring），config.toml 不保存明文。"; wrap: word-wrap; }
                        Text { text: "内置 OCR 识别在本地完成；安装包未内置模型时，首次使用可能需要联网下载。"; wrap: word-wrap; }
                    }
                }
            }
        }

        HorizontalBox {
            alignment: space-between;
            Text { text: status-text; vertical-alignment: center; color: #666666; }
            Button { text: "保存设置"; primary: true; clicked => { root.save(); } }
        }
    }
}
